# Copy to backend/.env (git-ignored). Real environment variables override this file.

# development | test | production. production refuses SQLite and CORS_ORIGINS=*.
APP_ENV=development

# Local default: SQLite file under backend/data/ (git-ignored).
DATABASE_URL=sqlite:///./data/stockpulse.db
# PostgreSQL (set via the environment or a secret store; never commit real values):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# Comma-separated browser origins allowed to call the API (the UI is served on :8000 by the legacy app).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
